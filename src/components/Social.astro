---
const { items } = Astro.props;
const icons = {
  Instagram: '<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.4A4 4 0 1 1 12.6 8 4 4 0 0 1 16 11.4z"/><path d="M17.5 6.5h.01"/>',
  Facebook: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
  Vimeo: '<path d="M2.5 9c1-.9 2-1.4 3-1.4 1.6 0 1.1 3 2 6 .5 1.6 1.5 3.4 3 3.4 2.6 0 6.2-4 7.2-8 .5-2.2-.6-3.2-2.2-3.2s-3.2 1-3.7 3.2"/>',
};
---
<span class="soc">{items.map(([n, u]) => <a href={u} rel="me noopener" target="_blank" aria-label={n} title={n}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[n]} /></a>)}</span>
