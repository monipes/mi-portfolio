---
import Base from '../../layouts/Base.astro';
import { t, site } from '../../site.js';
import { aiMotion, L, img } from '../../lib/data.js';
export function getStaticPaths() { return ['es','en','pt'].map(lang => ({ params: { lang } })); }
const { lang } = Astro.params; const tr = t[lang]; const list = aiMotion();
const title = 'AI Motion';
const desc = `${title} · ${site.name}.`;
---
<Base lang={lang} title={title} desc={desc} path="ai-motion/">
  <div class="wrap"><h1 class="pt">AI Motion</h1>
    <div class="grid motion-grid">
      {list.map(w => <a class="card motion-card" href={`/${lang}/ai-motion/${w.slug}/`}>
        <span class="art frame">{(w.video_file || w.youtube || w.vimeo) && <span class="play" aria-hidden="true">▶</span>}<img src={img(w.cover, 'thumb')} alt={w.alt_es || L(w,'title',lang)} loading="lazy" draggable="false" onerror={`this.onerror=null;this.src='${w.cover}'`} /></span>
        <span class="cap">{L(w,'title',lang)} <small>{w.year || ''}</small></span>
      </a>)}
    </div>
  </div>
</Base>
<style>
  .motion-grid{align-items:start}
  .motion-card{min-width:0;transition:transform .2s}
  .motion-card:hover{transform:translateY(-3px)}
  .motion-card .art{aspect-ratio:1/1}
  .motion-card .art img{width:100%;height:100%;object-fit:cover}
  .motion-card .cap{gap:.75rem;align-items:flex-start;line-height:1.3}
  .motion-card .cap small{white-space:nowrap}
</style>
