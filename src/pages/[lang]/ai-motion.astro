---
import Base from '../../layouts/Base.astro';
import { t, site } from '../../site.js';
export function getStaticPaths() { return ['es','en','pt'].map(lang => ({ params: { lang } })); }
const { lang } = Astro.params; const tr = t[lang];
---
<Base lang={lang} title="AI Motion" desc={`AI Motion · ${site.name}. ${tr.comingSoon}`} path="ai-motion/">
  <section class="wrap" style="min-height:48vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:5rem 1rem">
    <h1 style="font-size:clamp(2.8rem,8vw,5.5rem);margin:0 0 1.25rem">AI Motion</h1>
    <p style="color:var(--mut);font-size:1.15rem;max-width:38rem">{tr.comingSoon}</p>
  </section>
</Base>
