---
import Base from '../../../layouts/Base.astro';
import { langs, t } from '../../../site.js';
import { L, img } from '../../../lib/data.js';
import { visionArticles } from '../../../lib/vision.js';
export function getStaticPaths() { return langs.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params; const tr = t[lang]; const posts = visionArticles();
const intro = lang === 'en' ? 'Ideas, images and explorations to see the world from another angle.' : lang === 'pt' ? 'Ideias, imagens e explorações para olhar o mundo de outro jeito.' : 'Ideas, imágenes y exploraciones para mirar el mundo desde otro lugar.';
const dateLabel = (value) => { if (!value) return ''; const day = value instanceof Date ? value.toISOString().slice(0,10) : String(value).slice(0,10); const parsed = /^\d{4}-\d{2}-\d{2}$/.test(day) ? new Date(`${day}T12:00:00`) : new Date(value); if (Number.isNaN(parsed.getTime())) return ''; return parsed.toLocaleDateString(lang === 'pt' ? 'pt-BR' : lang === 'en' ? 'en-US' : 'es-AR', {day:'numeric',month:'long',year:'numeric'}); };
const read = lang === 'en' ? 'Read article' : lang === 'pt' ? 'Ler artigo' : 'Leer artículo';
---
<Base lang={lang} title={tr.visionAlternative} desc={intro} path="vision-alternativa/" image={posts[0] ? img(posts[0].image) : undefined}>
  <div class="wrap vision-page">
    <p class="eyebrow">MISS SAM · ESPACIO EDITORIAL</p>
    <h1>{tr.visionAlternative}</h1>
    <p class="intro">{intro}</p>
    {posts.length ? <section class="article-list" aria-label={tr.visionAlternative}>
      {posts.map((post, index) => <article class="article-card" data-article-index={index}>
        <a class="article-thumb frame" href={`/${lang}/vision-alternativa/${post.slug}/`}>
          <img src={img(post.image, 'thumb')} alt={L(post,'alt',lang) || L(post,'title',lang)} loading={index < 2 ? 'eager' : 'lazy'} />
        </a>
        <div class="article-copy">
          <p class="meta-line">{post.category || tr.visionAlternative}{dateLabel(post.date) ? ` · ${dateLabel(post.date)}` : ''}</p>
          <h2><a href={`/${lang}/vision-alternativa/${post.slug}/`}>{L(post,'title',lang)}</a></h2>
          <p class="article-excerpt">{L(post,'excerpt',lang)}</p>
          <a class="read-link" href={`/${lang}/vision-alternativa/${post.slug}/`}>{read} →</a>
        </div>
      </article>)}
    </section> : <p>{tr.empty}</p>}
    <nav class="pagination" aria-label={lang === 'en' ? 'Article pages' : lang === 'pt' ? 'Páginas de artigos' : 'Páginas de artículos'} hidden>
      <button type="button" class="page-button previous" disabled>← {lang === 'en' ? 'Previous' : lang === 'pt' ? 'Anterior' : 'Anterior'}</button>
      <span class="page-status" aria-live="polite"></span>
      <button type="button" class="page-button next">{lang === 'en' ? 'Next' : lang === 'pt' ? 'Próxima' : 'Siguiente'} →</button>
    </nav>
  </div>
</Base>
<script is:inline>
  (() => {
    const list = document.querySelector('.article-list');
    const nav = document.querySelector('.pagination');
    if (!list || !nav) return;
    const cards = [...list.querySelectorAll('[data-article-index]')];
    const perPage = 6;
    const total = Math.ceil(cards.length / perPage);
    if (total <= 1) return;
    let page = 1;
    const previous = nav.querySelector('.previous');
    const next = nav.querySelector('.next');
    const status = nav.querySelector('.page-status');
    const render = () => {
      cards.forEach((card, index) => { card.hidden = index < (page - 1) * perPage || index >= page * perPage; });
      previous.disabled = page === 1;
      next.disabled = page === total;
      status.textContent = `${page} / ${total}`;
      nav.hidden = false;
    };
    previous.addEventListener('click', () => { if (page > 1) { page--; render(); } });
    next.addEventListener('click', () => { if (page < total) { page++; render(); } });
    render();
  })();
</script>
<style>
  .vision-page{padding-top:clamp(2.5rem,7vw,5rem)}
  .eyebrow,.meta-line{font-size:.76rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mut);margin:0 0 .65rem}
  .vision-page h1{font-size:clamp(2.8rem,8vw,6rem);letter-spacing:-.045em}
  .intro{font-size:clamp(1.05rem,2vw,1.3rem);color:var(--mut);max-width:42rem;margin:1rem 0 2.5rem}
  .article-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem;align-items:stretch}
  .article-card{display:grid;grid-template-columns:minmax(125px,.78fr) minmax(0,1.22fr);gap:1.1rem;align-items:start;padding:1rem;border:1px solid var(--line);background:var(--band);min-width:0}
  .article-card[hidden]{display:none}
  .article-thumb{display:block;aspect-ratio:4/5;overflow:hidden;background:#fff;padding:9px;box-shadow:0 1px 2px #0002,0 8px 22px #0002}
  .article-thumb img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .35s}
  .article-thumb:hover img{transform:scale(1.025)}
  .article-copy{min-width:0}.article-copy h2{font-size:clamp(1.2rem,1.7vw,1.7rem);line-height:1.1;margin:.25rem 0 .65rem}
  .article-copy h2 a{text-decoration:none}.article-copy h2 a:hover{color:var(--acc)}
  .article-excerpt{color:var(--mut);font-size:.94rem;line-height:1.55;margin:.4rem 0}
  .read-link{display:inline-block;margin-top:.55rem;color:var(--acc);font-weight:600;text-decoration:none;font-size:.9rem}
  .pagination{display:flex;align-items:center;justify-content:center;gap:1.25rem;margin:2.5rem 0 1rem}
  .pagination[hidden]{display:none}.page-button{font:inherit;color:var(--fg);background:var(--band);border:1px solid var(--line);padding:.55rem .9rem;cursor:pointer}.page-button:disabled{opacity:.4;cursor:default}.page-status{color:var(--mut);font-size:.9rem}
  @media(max-width:1000px){.article-list{grid-template-columns:1fr}}
  @media(max-width:560px){.article-card{grid-template-columns:110px minmax(0,1fr);gap:.8rem;padding:.7rem}.article-thumb{padding:6px}.article-copy h2{font-size:1.15rem}.article-excerpt{font-size:.86rem}}
</style>
