---
import Base from '../../layouts/Base.astro';
import { t } from '../../site.js';
import { shopSettings, products, shopCategories } from '../../lib/shop.js';
export function getStaticPaths() { return ['es','en','pt'].map(lang => ({ params: { lang } })); }
const { lang } = Astro.params;
const tr = t[lang];
const settings = shopSettings;
const status = settings.status || 'construction';
const categories = shopCategories();
const allProducts = products();
const visibleProducts = allProducts.filter(p => !p.category || categories.some(c => c.slug === p.category));
---
<Base lang={lang} title={tr.shop} desc="Láminas y objetos de MISS SAM." path="tienda/">
  <div class="wrap shop-page">
    <header class="shop-intro">
      <p class="shop-eyebrow">MISS SAM · OBJETOS Y ARTE IMPRESO</p>
      <h1>Tienda</h1>
      <p>Descubrí las láminas y objetos de MISS SAM para llevar el arte a tus espacios.</p>
    </header>
    {status === 'construction' ? (
      <section class="shop-message"><h2>Tienda en construcción</h2><p>{settings.construction_message}</p></section>
    ) : status === 'paused' ? (
      <section class="shop-message"><h2>Tienda pausada</h2><p>{settings.paused_message}</p></section>
    ) : (
      <>
        <nav class="shop-categories" aria-label="Categorías de la tienda">
          {categories.map(category => <a href={`#categoria-${category.slug}`}>{category.title_es}</a>)}
        </nav>
        {categories.map(category => {
          const items = visibleProducts.filter(p => p.category === category.slug);
          return <section class="shop-category" id={`categoria-${category.slug}`}>
            <div class="shop-heading">
              <h2>{category.title_es}</h2>
              {category.coming_soon && <span class="shop-soon">Próximamente</span>}
            </div>
            {category.coming_soon ? <p class="shop-coming">Muy pronto vas a encontrar novedades en esta categoría.</p> : items.length ? <div class="shop-grid">{items.map(p => <a class="shop-card" href={`/${lang}/tienda/${p.slug}/`}>
              <span class="shop-card-image art frame">{p.image && <img src={p.image} alt={p.alt_es || p.title_es} loading="lazy" />}</span>
              <span class="shop-card-info">
                <strong>{p.title_es}</strong>
                {(p.price_before || p.price_label) && <span class="shop-card-prices">{p.price_before && <s>{p.price_before}</s>}{p.price_label && <b>{p.price_label}</b>}{p.discount_label && <em>{p.discount_label}</em>}</span>}
              </span>
            </a>)}</div> : <p class="shop-coming">Próximamente vas a encontrar productos en esta categoría.</p>}
          </section>;
        })}
      </>
    )}
    <section class="shop-contact">
      <h2>¿Tenés alguna consulta?</h2>
      <p>Podés comunicarte con MISS SAM por estos medios:</p>
      <div class="shop-contact-list">
        {settings.contacts?.instagram_enabled && settings.contacts.instagram && <a class="shop-social-button" href={settings.contacts.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>}
        {settings.contacts?.facebook_enabled && settings.contacts.facebook && <a class="shop-social-button" href={settings.contacts.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>}
        {settings.contacts?.email_enabled && settings.contacts.email && <p class="shop-email"><strong>Email:</strong> <a href={`mailto:${settings.contacts.email}`}>{settings.contacts.email}</a></p>}
      </div>
    </section>
  </div>
  <style>
    .shop-page{padding-bottom:4rem}
    .shop-intro{padding:1.5rem 0 1.25rem;max-width:760px}
    .shop-eyebrow{font-size:.72rem;letter-spacing:.16em;color:var(--acc);font-weight:700;margin:0 0 .7rem}
    .shop-intro h1{font-size:clamp(2.2rem,5vw,3.3rem);margin:0 0 .55rem}
    .shop-intro>p:last-child{color:var(--mut);font-size:1.05rem;line-height:1.65;margin:0}
    .shop-categories{display:flex;gap:.65rem;flex-wrap:wrap;margin:1.5rem 0 3rem}
    .shop-categories a,.shop-social-button{display:inline-flex;align-items:center;justify-content:center;padding:.62rem 1.15rem;border:1px solid var(--acc);border-radius:4px;background:var(--acc);color:#fff;text-decoration:none;font-size:.9rem;font-weight:700;transition:filter .2s,transform .2s}
    .shop-categories a:hover,.shop-social-button:hover{filter:brightness(.94);transform:translateY(-1px)}
    .shop-message{margin:2rem 0 4rem;padding:clamp(2rem,6vw,5rem);background:var(--band);border:1px solid var(--line);max-width:850px}
    .shop-message h2{margin:0 0 1rem;font-size:clamp(2rem,5vw,3rem)}.shop-message p{max-width:55ch;color:var(--mut);font-size:1.05rem}
    .shop-category{margin:3.5rem 0}
    .shop-heading{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-bottom:.8rem;margin-bottom:1.5rem;border-bottom:1px solid var(--line)}
    .shop-heading h2{margin:0;font-size:clamp(1.55rem,3vw,2rem)}
    .shop-soon{border:1px solid var(--acc);color:var(--acc);border-radius:999px;padding:.35rem .75rem;font-size:.78rem;white-space:nowrap}
    .shop-coming{color:var(--mut);padding:.5rem 0}
    .shop-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,230px),1fr));gap:1.6rem}
    .shop-card{display:block;color:inherit;text-decoration:none;min-width:0}
    .shop-card-image{display:flex;align-items:center;justify-content:center;background:#fff;overflow:hidden;border:0;border-radius:0;box-shadow:0 1px 2px #0002,0 10px 28px #0002;padding:14px}
    .shop-card-image.art.frame{padding:14px}
    .shop-card-image img{width:100%;height:auto;max-height:480px;object-fit:contain;display:block;transition:transform .3s}
    .shop-card:hover .shop-card-image img{transform:scale(1.025)}
    .shop-card-info{display:flex;flex-direction:column;align-items:center;text-align:center;gap:.45rem;padding:1rem .25rem}
    .shop-card-info strong{font-size:1.02rem;line-height:1.35;font-weight:650}
    .shop-card-prices{display:flex;align-items:center;justify-content:center;gap:.6rem;flex-wrap:wrap;margin-top:.15rem}
    .shop-card-prices s{color:var(--mut);font-size:.9rem}
    .shop-card-prices b{font-size:1.12rem;font-weight:750;color:var(--fg)}
    .shop-card-prices em{font-style:normal;background:var(--acc);color:white;border-radius:4px;padding:.22rem .45rem;font-size:.72rem;font-weight:700;white-space:nowrap}
    .shop-contact{border-top:1px solid var(--line);margin-top:4rem;padding:1.7rem 0 0}
    .shop-contact h2{margin:0 0 .45rem;font-size:1.35rem}.shop-contact>p{color:var(--mut);font-size:.92rem;margin:.4rem 0 1rem}
    .shop-contact-list{display:flex;gap:.7rem;align-items:center;flex-wrap:wrap}.shop-email{flex-basis:100%;margin-top:.45rem!important}
    .shop-contact-list p{margin:0;color:var(--fg);font-size:.92rem}.shop-contact-list small{color:var(--mut);font-size:.75rem}
    .shop-contact-list a{color:var(--fg);text-decoration:underline;text-underline-offset:3px}.shop-contact-list a.shop-social-button{color:#fff;text-decoration:none}
  </style>
</Base>
