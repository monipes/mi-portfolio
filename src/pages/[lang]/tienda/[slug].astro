---
import Base from '../../../layouts/Base.astro';
import { t } from '../../../site.js';
import { products, shopSettings } from '../../../lib/shop.js';
export function getStaticPaths() {
  const all = products();
  return ['es','en','pt'].flatMap(lang => all.map(product => ({ params: { lang, slug: product.slug }, props: { product } })));
}
const { lang, slug } = Astro.params;
const { product } = Astro.props;
const tr = t[lang];
const settings = shopSettings;
const status = settings.status || 'construction';
const images = [product.image, ...(product.gallery || []).map(g => typeof g === 'string' ? g : g.image)].filter(Boolean);
const contacts = settings.contacts || {};
const whatsapp = contacts.whatsapp || '';
const whatsappUrl = whatsapp.startsWith('http') ? whatsapp : `https://wa.me/${whatsapp.replace(/[^0-9]/g,'')}`;
const variants = product.variants || [];
const initialVariant = variants[0] || {};
const initialPrice = initialVariant.price || product.price_label || '';
const initialBefore = initialVariant.price_before || product.price_before || '';
const initialDiscount = initialVariant.discount_label || product.discount_label || '';
const initialUrl = initialVariant.url || product.buy_url || '';
const canonical = `/${lang}/tienda/${slug}/`;
---
<Base lang={lang} title={product.title_es} desc={product.description_es || product.title_es} path={`tienda/${slug}/`} image={product.image || '/icon-512.png'}>
  <div class="wrap product-page">
    <nav class="bc"><a href={`/${lang}/`}>{tr.home}</a><span aria-hidden="true">›</span><a href={`/${lang}/tienda/`}>Tienda</a><span aria-hidden="true">›</span><span>{product.title_es}</span></nav>
    {status !== 'active' ? <section class="product-unavailable"><h1>{status === 'paused' ? 'Tienda pausada' : 'Tienda en construcción'}</h1><p>{status === 'paused' ? settings.paused_message : settings.construction_message}</p><a class="back" href={`/${lang}/tienda/`}>Volver a Tienda</a></section> : (
      <>
        <a class="back" href={`/${lang}/tienda/`}>← Volver a Tienda</a>
        <div class="product-layout">
          <div class="product-gallery">
            {product.video_file && <video class="product-video" src={product.video_file} controls playsinline preload="metadata" poster={product.image || undefined}></video>}
            {images.map((src,i) => <figure class="product-image"><img src={src} alt={i === 0 ? (product.alt_es || product.title_es) : (product.gallery?.[i-1]?.alt_es || product.title_es)} loading={i ? 'lazy' : 'eager'} /></figure>)}
          </div>
          <section class="product-info">
            <p class="product-availability">{product.availability_es || 'Disponible'}</p>
            <h1>{product.title_es}</h1>
            {product.description_es && <p class="product-description">{product.description_es}</p>}
            <div class="product-price" aria-live="polite">
              {initialBefore && <s id="price-before" hidden={!initialBefore}>{initialBefore}</s>}
              <strong id="price-current">{initialPrice}</strong>
              <span id="price-discount" hidden={!initialDiscount}>{initialDiscount}</span>
            </div>
            {variants.length > 0 && <fieldset class="product-variants">
              <legend>Formato</legend>
              <div class="variant-options">
                {variants.map((v,i) => <button type="button" class:list={['variant-option', i === 0 && 'is-selected']} aria-pressed={i === 0 ? 'true' : 'false'} data-index={i} data-price={v.price || ''} data-before={v.price_before || ''} data-discount={v.discount_label || ''} data-url={v.url || ''}>
                  <span>{v.label}</span>{v.price && <small>{v.price}</small>}
                </button>)}
              </div>
            </fieldset>}
            {product.specifications_es && <div class="product-specs"><p>{product.specifications_es}</p></div>}
            <a class:list={['buy-button', !initialUrl && 'is-disabled']} id="marketplace-buy" href={initialUrl || undefined} target="_blank" rel="noopener noreferrer" aria-disabled={initialUrl ? 'false' : 'true'}>Comprar en Mercado Libre <span aria-hidden="true">↗</span></a>
            <p class="marketplace-note">Finalizás la compra en <strong>Mercado Libre</strong>: ahí elegís el medio de pago y el envío.</p>
            <div class="product-actions">
              {contacts.whatsapp_enabled && whatsapp ? <a class="whatsapp-button" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Consultar por WhatsApp</a> : <span class="whatsapp-button is-disabled" aria-disabled="true" title="Configurá el número de WhatsApp desde el panel">Consultar por WhatsApp</span>}
              <button class="share-button" id="share-product" type="button" data-url={canonical}>Compartir</button>
            </div>
          </section>
        </div>
        <script is:inline>
          const optionButtons = document.querySelectorAll('.variant-option');
          const priceBefore = document.getElementById('price-before');
          const priceCurrent = document.getElementById('price-current');
          const priceDiscount = document.getElementById('price-discount');
          const buyButton = document.getElementById('marketplace-buy');
          optionButtons.forEach((button) => {
            button.addEventListener('click', () => {
              optionButtons.forEach((item) => {
                item.classList.remove('is-selected');
                item.setAttribute('aria-pressed', 'false');
              });
              button.classList.add('is-selected');
              button.setAttribute('aria-pressed', 'true');
              const before = button.dataset.before || '';
              const price = button.dataset.price || '';
              const discount = button.dataset.discount || '';
              const url = button.dataset.url || '';
              if (priceBefore) { priceBefore.textContent = before; priceBefore.hidden = !before; }
              priceCurrent.textContent = price;
              priceDiscount.textContent = discount;
              priceDiscount.hidden = !discount;
              if (url) buyButton.href = url; else buyButton.removeAttribute('href');
              buyButton.classList.toggle('is-disabled', !url);
              buyButton.setAttribute('aria-disabled', url ? 'false' : 'true');
            });
          });
          const shareButton = document.getElementById('share-product');
          shareButton?.addEventListener('click', async () => {
            const url = new URL(shareButton.dataset.url, window.location.origin).href;
            try {
              if (navigator.share) await navigator.share({title: document.title, url});
              else { await navigator.clipboard.writeText(url); shareButton.textContent = 'Enlace copiado'; }
            } catch (e) {}
          });
        </script>
      </>
    )}
  </div>
  <style>
    .product-page{padding-bottom:4rem}
    .bc{display:flex;gap:.55rem;align-items:center;flex-wrap:wrap;font-size:.82rem;color:var(--mut);margin:1rem 0 1.3rem}
    .bc a{color:var(--mut);text-decoration:none}.bc a:hover{text-decoration:underline}
    .back{display:inline-block;color:var(--mut);text-decoration:none;font-size:.9rem;margin:0 0 1.5rem}.back:hover{color:var(--fg)}
    .product-layout{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr);gap:clamp(2rem,5vw,5rem);align-items:start}
    .product-gallery{display:grid;grid-template-columns:1fr;gap:1rem}
    .product-image{margin:0;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;background:#fff;border:1px solid #e7e2dc;border-radius:0;padding:clamp(1.1rem,3.5vw,2.5rem);box-shadow:0 1px 2px #0002,0 10px 28px #0002;overflow:hidden}
    .product-image img{display:block;width:100%;height:100%;object-fit:contain}
    .product-video{width:100%;aspect-ratio:16/9;background:#000;border-radius:10px}
    .product-info{max-width:520px;width:100%;margin:0 auto}
    .product-availability{font-size:.82rem;color:var(--mut);margin:0 0 .9rem}
    .product-info h1{text-align:center;font-size:clamp(1.7rem,3vw,2.35rem);line-height:1.2;margin:0 auto 1rem;max-width:20ch}
    .product-description{color:var(--mut);line-height:1.65;text-align:center;margin:0 auto 1.1rem;max-width:48ch}
    .product-price{display:flex;justify-content:center;align-items:center;gap:.65rem;flex-wrap:wrap;margin:1.15rem 0 1.4rem}
    .product-price s{color:var(--mut);font-size:1rem}
    .product-price strong{font-size:1.65rem;line-height:1.2;font-weight:750;color:var(--fg)}
    .product-price span{background:var(--acc);color:#fff;border-radius:4px;padding:.25rem .5rem;font-size:.76rem;font-weight:750}
    .product-price span[hidden],.product-price s[hidden]{display:none}
    .product-variants{border:0;padding:0;margin:1.5rem 0}
    .product-variants legend{font-size:.9rem;font-weight:650;margin-bottom:.7rem}
    .variant-options{display:flex;gap:.65rem;flex-wrap:wrap}
    .variant-option{min-width:112px;display:flex;flex-direction:column;align-items:center;gap:.3rem;border:1px solid var(--line);border-radius:7px;background:#fff;color:var(--fg);padding:.8rem 1.1rem;font:inherit;font-size:1.08rem;font-weight:650;cursor:pointer;transition:border-color .15s,background .15s}
    .variant-option small{font-size:.88rem;color:var(--mut);font-weight:500}
    .variant-option:hover{border-color:var(--acc)}
    .variant-option.is-selected{border:2px solid var(--acc);background:var(--band);padding:calc(.7rem - 1px) calc(1rem - 1px)}
    .product-specs{font-size:.78rem;line-height:1.55;color:var(--mut);white-space:pre-line;margin:1.2rem 0 1.3rem}
    .product-specs p{margin:0}
    .buy-button{display:flex;align-items:center;justify-content:center;gap:.6rem;width:100%;min-height:58px;padding:1rem 1.2rem;border-radius:9px;background:#ffe600;color:#25215b;text-decoration:none;font-weight:750;text-align:center;box-shadow:0 3px 7px rgba(0,0,0,.12);transition:filter .15s,transform .15s}
    .buy-button:hover{filter:brightness(.97);transform:translateY(-1px)}
    .buy-button.is-disabled{opacity:.72;cursor:not-allowed;filter:grayscale(.08)}
    .marketplace-note{background:#eee;border-left:3px solid var(--acc);padding:.8rem 1rem;font-size:.88rem;line-height:1.55;color:var(--fg);margin:.65rem 0 2rem}
    .product-actions{display:flex;align-items:center;gap:1.25rem;flex-wrap:wrap;margin-top:1.2rem}
    .whatsapp-button{display:inline-flex;align-items:center;justify-content:center;padding:.55rem .9rem;border:1px solid var(--line);border-radius:6px;color:var(--fg);text-decoration:none;font-size:.88rem;font-weight:600}
    .whatsapp-button:hover{border-color:var(--acc)}.whatsapp-button.is-disabled{opacity:.65;cursor:default}
    .share-button{color:var(--fg);text-decoration:underline;text-underline-offset:3px;font-size:.9rem;border:0;padding:0;background:none;font:inherit;cursor:pointer}
    .product-unavailable{background:var(--band);padding:3rem;margin:2rem 0;max-width:700px}.product-unavailable h1{font-size:2.5rem}
    @media(max-width:800px){.product-layout{grid-template-columns:1fr;gap:2rem}.product-info{max-width:620px}.product-image{max-width:100%}}
  </style>
</Base>
