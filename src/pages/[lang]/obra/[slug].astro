---
import Base from '../../../layouts/Base.astro';
import { langs, t, site } from '../../../site.js';
import { works, L, embed, img, dim } from '../../../lib/data.js';
export function getStaticPaths() { const all = works(); return ['es','en','pt'].flatMap(lang => all.map((w, i) => ({ params: { lang, slug: w.slug }, props: { w, prev: all[i - 1] || null, next: all[i + 1] || null } }))); }
const { lang, slug } = Astro.params; const { w, prev, next } = Astro.props; const origin = Astro.site?.origin ?? '';
const catKey = w.category === 'collage-animado' ? 'animated' : 'digital';
const crumbs = [[t[lang].home, `/${lang}/`],[t[lang].portfolio, `/${lang}/portfolio/`],[t[lang][catKey], `/${lang}/portfolio/${w.category}/`]]; const tr = t[lang];
const title = L(w,'title',lang), desc = L(w,'desc',lang); const v = embed(w);
const art = { '@context':'https://schema.org','@type':'VisualArtwork',name:title,description:desc,image:`${Astro.site?.origin ?? ''}${img(w.image)}`,dateCreated:w.year ? String(w.year) : undefined,artMedium:w.technique,creator:{'@type':'Person',name:site.name} };
const ld = [art, { '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[...crumbs.map((c,i)=>({ '@type':'ListItem',position:i+1,name:c[0],item:origin+c[1] })),{ '@type':'ListItem',position:crumbs.length+1,name:title }] }];
---
<Base lang={lang} title={title} desc={(desc || `${title}${w.year ? ' · ' + w.year : ''}`).slice(0,155)} path={`obra/${slug}/`} image={img(w.image)} ld={ld}>
  <div class="wrap">
    <nav class="bc" aria-label={tr.crumbs}>{crumbs.map(c => <><a href={c[1]}>{c[0]}</a><span aria-hidden="true">›</span></>)}<span aria-current="page">{title}</span></nav>
    <a class="back" href={`/${lang}/portfolio/${w.category}/${w.year ? '#y' + w.year : ''}`}>← {tr[catKey]}</a>
    <div class="two">
    <div>
      {v ? <iframe class="video" src={v} title={title} allow="fullscreen; picture-in-picture" loading="lazy"></iframe>
         : w.video_file ? <video class="video" src={w.video_file} autoplay loop muted playsinline controlslist="nodownload" disablepictureinpicture oncontextmenu="return false"></video> : null}
      <span class="art frame" style={v || w.video_file ? 'margin-top:1rem' : ''}><img src={img(w.image)} alt={L(w,'alt',lang) || title} draggable="false" {...dim(w.image)} onerror={`this.onerror=null;this.src='${w.image}'`} /></span>
      {(w.gallery || []).map(g => <span class="art frame" style="margin-top:1rem"><img src={img(g.image)} alt={L(g,'alt',lang) || title} loading="lazy" draggable="false" onerror={`this.onerror=null;this.src='${g.image}'`} /></span>)}
    </div>
    <aside><h1 style="font-size:clamp(2rem,4vw,3rem)">{title}</h1>
      <div class="meta">{w.year && <span>{tr.year}<b>{w.year}</b></span>}<span>{tr.technique}<b>{w.technique}</b></span>{w.size && <span>{tr.size}<b>{w.size}</b></span>}</div>
      {desc && <p style="white-space:pre-line">{desc}</p>}
      {(w.editions || []).length > 0 && <ul class="ed">{w.editions.map(e => <li><span>{e.label}{e.price && <b>{e.price}</b>}</span>{e.url && <a class="btn" href={e.url} rel="noopener">{tr.buy}</a>}</li>)}</ul>}
      {w.buy_url && <a class="btn" href={w.buy_url} rel="noopener">{tr.shopLink}</a>}
    </aside></div>
    <nav class="pn" aria-label={tr.more}>
      {prev ? <a href={`/${lang}/obra/${prev.slug}/`} rel="prev">← {L(prev,'title',lang)}</a> : <span></span>}
      <a class="btn" href={`/${lang}/`}>{tr.home}</a>
      {next ? <a href={`/${lang}/obra/${next.slug}/`} rel="next">{L(next,'title',lang)} →</a> : <span></span>}
    </nav>
  </div>
</Base>
