---
import Base from '../../layouts/Base.astro';
import { t, site } from '../../site.js';
import { expos, L, img, dim, embed } from '../../lib/data.js';
export function getStaticPaths() { return ['es','en','pt'].map(lang => ({ params: { lang } })); }
const { lang } = Astro.params; const tr = t[lang]; const list = expos(); const origin = Astro.site?.origin ?? '';
const M = { es:['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'], en:['January','February','March','April','May','June','July','August','September','October','November','December'], pt:['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'] }[lang];
const cap = (s) => s[0].toUpperCase() + s.slice(1);
const fmt = (s) => { const [y, m, d] = String(s).split('-'); if (!m) return y; const mn = M[+m - 1]; if (!d) return lang === 'en' ? `${cap(mn)} ${y}` : `${cap(mn)} de ${y}`; return lang === 'en' ? `${cap(mn)} ${+d}, ${y}` : `${+d} de ${mn} de ${y}`; };
const years = [...new Set(list.map(e => e.start.slice(0, 4)))];
const place = (e) => [L(e,'city',lang), L(e,'country',lang)].filter(Boolean).join(', ');
const first = list.find(e => e.image);
const ld = { '@context':'https://schema.org','@graph': list.map(e => ({ '@type':'ExhibitionEvent',name:L(e,'title',lang),startDate:e.start,description:L(e,'desc',lang) || undefined,image:e.image ? origin + img(e.image) : undefined,location:{ '@type':'Place',name:e.venue,address:(e.address || L(e,'city',lang)) ? { '@type':'PostalAddress',streetAddress:e.address || undefined,addressLocality:L(e,'city',lang) || undefined,addressCountry:L(e,'country',lang) || undefined } : undefined },performer:{ '@type':'Person',name:site.name } })) };
---
<Base lang={lang} title={tr.exhibitions} desc={`${tr.exhibitions} · ${site.name}: ${list.slice(0, 3).map(e => L(e,'title',lang)).join(', ')}`} path="exposiciones/" ld={ld} image={first ? img(first.image) : undefined}>
  <div class="wrap">
    <h1 class="pt">{tr.exhibitions}</h1>
    {list.length ? <>
      {years.length > 1 && <nav class="years" aria-label={tr.years}>{years.map(y => <a href={`#x${y}`}>{y}</a>)}</nav>}
      {years.map(y => <section id={`x${y}`} class="yr"><h2>{y}</h2>
        {list.filter(e => e.start.startsWith(y)).map(e => {
          const v = embed(e);
          return <article class="ex">
            {(e.image || v || e.video_file) && <div class="media">
              {e.image && <span class="art frame"><img src={img(e.image)} alt={L(e,'alt',lang) || L(e,'title',lang)} loading="lazy" draggable="false" {...dim(e.image)} onerror={`this.onerror=null;this.src='${e.image}'`} /></span>}
              {v ? <iframe class="video" src={v} title={L(e,'title',lang)} allow="fullscreen; picture-in-picture" loading="lazy"></iframe> : e.video_file ? <video class="vid" src={e.video_file} controls preload="metadata" playsinline controlslist="nodownload" disablepictureinpicture oncontextmenu="return false"></video> : null}
            </div>}
            <div class="info">
              <p class="when"><time datetime={e.start}>{fmt(e.start)}</time></p>
              <h3>{L(e,'title',lang)}</h3>
              <p class="where"><b>{e.venue}</b></p>
              {e.address && <p class="where">{e.address}</p>}
              {place(e) && <p class="where">{place(e)}</p>}
              {L(e,'desc',lang) && <p style="margin:1rem 0 0;white-space:pre-line">{L(e,'desc',lang)}</p>}
              {(e.work || e.url) && <div class="acts">
                {e.work && <a class="btn" href={`/${lang}/obra/${e.work}/`}>{tr.viewWork}</a>}
                {e.url && <a class="btn ghost" href={e.url} target="_blank" rel="noopener">{tr.moreInfo}</a>}
              </div>}
            </div>
          </article>;
        })}
      </section>)}
    </> : <p>{tr.empty}</p>}
  </div>
</Base>
