---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { t, site } from '../../site.js';
import { works, L, img, embed, dim } from '../../lib/data.js';
import portada from '../../data/portada.json';
import acerca from '../../data/acerca.json';
export function getStaticPaths() { return ['es','en','pt'].map(lang => ({ params: { lang } })); }
const { lang } = Astro.params; const tr = t[lang]; const all = works();
const byFo = (a, b) => (a.featured_order ?? 99) - (b.featured_order ?? 99);
const feat = all.filter(w => w.featured).sort(byFo); const shown = (feat.length ? feat : all.slice(0, 7)).slice(0, 8);
const hero = all.find(w => w.hero) || feat[0] || all[0];
const bn = all.filter(w => w.banner).sort(byFo); const slides = [hero, ...(bn.length ? bn : feat).filter(w => w !== hero)].filter(Boolean).slice(0, 10);
const vid = embed({ youtube: portada.video_youtube, vimeo: portada.video_vimeo });
const origin = Astro.site?.origin ?? '';
const person = { '@context':'https://schema.org','@type':'Person',name:site.name,url:`${origin}/${lang}/`,description:tr.homeDesc,image:acerca.photo ? origin + img(acerca.photo) : undefined,jobTitle:'Visual artist',nationality:{ '@type':'Country',name:'Peru' },address:{ '@type':'PostalAddress',addressCountry:'AR' },sameAs:site.social.map(s => s[1]),knowsAbout:['surreal collage','digital collage','animated collage','illustration','surrealism'] };
const ld = [person, { '@context':'https://schema.org','@type':'WebSite',name:site.name,url:`${origin}/${lang}/`,inLanguage:lang === 'pt' ? 'pt-BR' : lang }];
---
<Base lang={lang} title={tr.homeTitle} desc={tr.homeDesc} path="" ld={ld} image={hero ? img(hero.image) : undefined}>
  {slides.length > 0 && <section class="hero" aria-roledescription="carousel" aria-label={tr.featured}>
    <div class="t"><h1 class="sr">{site.name} · {tr.title}. {tr.intro}</h1><p class="k">{tr.title}</p><p class="sub">{tr.tagline}</p><p class="s">{tr.intro}</p></div>
    <div class="stage">
      {slides.map((w, i) => <span class={`art slide${i === 0 ? ' on' : ''}`} aria-hidden={i === 0 ? undefined : 'true'}><img src={img(w.image)} style={`object-position:50% ${w.banner_y ?? 55}%`} alt={L(w,'alt',lang) || L(w,'title',lang)} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} draggable="false" /></span>)}
      {slides.length > 1 && <button id="hp" class="hp" data-pause={tr.pause} data-play={tr.play} aria-label={tr.pause}></button>}
    </div>
  </section>}
  <div class="wrap">
    <h2>{tr.featured}</h2>
    <div class="grid four">{shown.map(w => <Card w={w} lang={lang} />)}<a class="card seeall" href={`/${lang}/portfolio/`}><span class="tile">{tr.all} →</span></a></div>
  </div>
  <div class="band"><div class="wrap">
    <section class="split">
      <div><h2 style="margin:0 0 1rem">{tr.exhibitions}</h2><p style="font-size:1.15rem;margin:0 0 1.5rem">{L(portada,'expo_text',lang)}</p><a class="btn" href={`/${lang}/exposiciones/`}>{tr.viewExpo}</a></div>
      {portada.expo_image && <span class="art frame"><img src={img(portada.expo_image)} alt={L(portada,'expo_alt',lang) || tr.exhibitions} loading="lazy" draggable="false" /></span>}
    </section>
  </div></div>
  <div class="wrap">
    <h2>{tr.animated}</h2>
    <section class="split" style="margin:1.5rem 0 2.5rem">
      {vid ? <iframe class="video" src={vid} title={L(portada,'video_title',lang)} allow="fullscreen; picture-in-picture" loading="lazy"></iframe> : <div class="video ph" aria-hidden="true">▶</div>}
      <div><h3 style="font-size:1.7rem;margin:0 0 .4rem">{L(portada,'video_title',lang)}</h3><p style="color:var(--mut);margin:0 0 1rem">{portada.video_year}</p>{L(portada,'video_desc',lang) && <p style="margin:0">{L(portada,'video_desc',lang)}</p>}</div>
    </section>
    {portada.video2_file && <section class="split" style="margin:0 0 2.5rem">
      <video class="video" src={portada.video2_file} poster={portada.video2_poster ? img(portada.video2_poster) : undefined} controls preload="metadata" playsinline controlslist="nodownload" disablepictureinpicture oncontextmenu="return false" title={L(portada,'video2_title',lang)}></video>
      <div><h3 style="font-size:1.7rem;margin:0 0 .4rem">{L(portada,'video2_title',lang)}</h3><p style="color:var(--mut);margin:0 0 1rem">{portada.video2_year}</p>{L(portada,'video2_desc',lang) && <p style="margin:0">{L(portada,'video2_desc',lang)}</p>}</div>
    </section>}
    <p style="margin:0 0 5rem"><a class="btn" href={`/${lang}/portfolio/collage-animado/`}>{tr.viewWorks}</a></p>
  </div>
<script is:inline>
(function(){var s=[].slice.call(document.querySelectorAll('.hero .slide')),b=document.getElementById('hp');if(s.length<2||!b)return;
var i=0,t=null,PA='<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14"/><rect x="14" y="5" width="4" height="14"/></svg>',PL='<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4l13 8-13 8z"/></svg>';
function show(n){s[i].classList.remove('on');s[i].setAttribute('aria-hidden','true');i=n;s[i].classList.add('on');s[i].removeAttribute('aria-hidden')}
function stop(){if(t){clearInterval(t);t=null}b.innerHTML=PL;b.setAttribute('aria-label',b.dataset.play);b.dataset.s='paused'}
function play(){if(t)clearInterval(t);t=setInterval(function(){show((i+1)%s.length)},6000);b.innerHTML=PA;b.setAttribute('aria-label',b.dataset.pause);b.dataset.s='playing'}
b.onclick=function(){b.dataset.s==='playing'?stop():play()};
document.addEventListener('visibilitychange',function(){if(document.hidden&&b.dataset.s==='playing'){clearInterval(t);t=null;b.dataset.s='hidden'}else if(!document.hidden&&b.dataset.s==='hidden'){play()}});
matchMedia('(prefers-reduced-motion: reduce)').matches?stop():play();})();
</script>
</Base>
