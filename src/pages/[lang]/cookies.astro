---
import Base from '../../layouts/Base.astro';
import { site } from '../../site.js';
export function getStaticPaths() { return ['es','en','pt'].map(lang => ({ params: { lang } })); }
const { lang } = Astro.params;
const copy = {
  es: { title:'Política de cookies', sections:[
    ['Cookies y almacenamiento del navegador','Una cookie es un pequeño archivo que un sitio puede guardar en el navegador. MISS SAM también utiliza sessionStorage para recordar temporalmente la preferencia de apariencia (modo claro u oscuro) durante la sesión. sessionStorage no es una cookie y se elimina al finalizar la sesión del navegador.'],
    ['Servicios externos','El selector de traducción puede conectar con Google Translate y algunas obras pueden mostrar contenido audiovisual de plataformas externas. Esos proveedores pueden utilizar sus propias cookies o tecnologías, sujetas a sus respectivas políticas.'],
    ['Cómo gestionar las cookies','Podés revisar, bloquear o eliminar cookies desde la configuración de tu navegador. Si bloqueás tecnologías de terceros, algunas funciones externas podrían no estar disponibles.'],
    ['Contacto','Para consultas sobre esta política, utilizá el formulario de contacto.']
  ]},
  en: { title:'Cookie policy', sections:[
    ['Cookies and browser storage','A cookie is a small file a website may store in a browser. MISS SAM also uses sessionStorage to temporarily remember the selected appearance (light or dark mode) during a session. sessionStorage is not a cookie and is cleared when the browser session ends.'],
    ['External services','The translation selector may connect to Google Translate, and some artworks may display audiovisual content from external platforms. Those providers may use their own cookies or technologies under their respective policies.'],
    ['Managing cookies','You can review, block or delete cookies in your browser settings. Blocking third-party technologies may affect some external features.'],
    ['Contact','For questions about this policy, please use the contact form.']
  ]},
  pt: { title:'Política de cookies', sections:[
    ['Cookies e armazenamento do navegador','Um cookie é um pequeno arquivo que um site pode armazenar no navegador. MISS SAM também utiliza sessionStorage para lembrar temporariamente a preferência de aparência (modo claro ou escuro) durante a sessão. sessionStorage não é um cookie e é apagado ao final da sessão do navegador.'],
    ['Serviços externos','O seletor de tradução pode conectar ao Google Translate e algumas obras podem exibir conteúdo audiovisual de plataformas externas. Esses fornecedores podem utilizar seus próprios cookies ou tecnologias, conforme suas políticas.'],
    ['Como gerenciar cookies','Você pode consultar, bloquear ou excluir cookies nas configurações do navegador. Bloquear tecnologias de terceiros pode afetar algumas funções externas.'],
    ['Contato','Para dúvidas sobre esta política, utilize o formulário de contato.']
  ]}
}[lang];
const desc = copy.sections.map(x => x[1]).join(' ').slice(0,155);
const ld = { '@context':'https://schema.org', '@type':'WebPage', name:`${copy.title} · ${site.name}`, description:desc, inLanguage:lang === 'pt' ? 'pt-BR' : lang };
---
<Base lang={lang} title={copy.title} desc={desc} path="cookies/" ld={ld}>
  <article class="wrap legal-page">
    <h1 class="pt">{copy.title}</h1>
    {copy.sections.map(([heading, body]) => <section class="legal-section"><h2>{heading}</h2><p>{body}</p></section>)}
    <a class="btn legal-contact" href={`/${lang}/contacto/`}>{lang === 'es' ? 'Contacto' : lang === 'en' ? 'Contact' : 'Contato'}</a>
  </article>
</Base>
