---
import Base from '../../layouts/Base.astro';
import { site } from '../../site.js';
export function getStaticPaths() { return ['es','en','pt'].map(lang => ({ params: { lang } })); }
const { lang } = Astro.params;
const copy = {
  es: { title: "Cookies", h1: "Cookies y almacenamiento local", body: "Este sitio no utiliza cookies propias de publicidad ni herramientas de seguimiento analítico. Para recordar la preferencia de apariencia (claro u oscuro), guarda una opción en el almacenamiento de sesión del navegador. Algunos contenidos o servicios externos, como videos insertados y recursos tipográficos, pueden aplicar sus propias tecnologías; su funcionamiento depende de las políticas de esos proveedores." },
  en: { title: "Cookies", h1: "Cookies and local storage", body: "This website does not use its own advertising cookies or analytics tracking tools. It stores the light or dark appearance preference in the browser session storage. Some external content or services, such as embedded videos and font resources, may use their own technologies; their operation is governed by those providers’ policies." },
  pt: { title: "Cookies", h1: "Cookies e armazenamento local", body: "Este site não utiliza cookies próprios de publicidade nem ferramentas de rastreamento analítico. A preferência de aparência (claro ou escuro) é guardada no armazenamento de sessão do navegador. Alguns conteúdos ou serviços externos, como vídeos incorporados e recursos de fontes, podem utilizar tecnologias próprias; seu funcionamento depende das políticas desses fornecedores." },
};
const c = copy[lang];
const desc = c.body.slice(0, 155);
const ld = { '@context':'https://schema.org', '@type':'WebPage', name:`${c.title} · ${site.name}`, description:desc, inLanguage:lang === 'pt' ? 'pt-BR' : lang };
---
<Base lang={lang} title={c.title} desc={desc} path="cookies/" ld={ld}>
  <article class="wrap legal-page" style="max-width:760px;padding-top:2rem">
    <h1 class="pt">{c.h1}</h1>
    <p>{c.body}</p>
    <p><a href={`/${lang}/contacto/`}>{lang === 'es' ? 'Contacto' : lang === 'en' ? 'Contact' : 'Contato'}</a></p>
  </article>
</Base>
