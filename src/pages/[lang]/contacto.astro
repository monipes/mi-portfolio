---
import Base from '../../layouts/Base.astro';
import Social from '../../components/Social.astro';
import { t, site } from '../../site.js';
export function getStaticPaths() { return ['es','en','pt'].map(lang => ({ params: { lang } })); }
const { lang } = Astro.params; const tr = t[lang];
const F = {
  es: { name:'Nombre completo', email:'Correo electrónico', subject:'Asunto', message:'Mensaje', consent:'He leído y acepto la', policy:'política de datos', send:'Enviar mensaje', sending:'Enviando…', ok:'¡Gracias! Tu mensaje fue enviado. Te respondo pronto.', err:'No se pudo enviar. Probá de nuevo en un rato.' },
  en: { name:'Full name', email:'Email', subject:'Subject', message:'Message', consent:'I have read and agree to the', policy:'privacy policy', send:'Send message', sending:'Sending…', ok:'Thank you! Your message was sent. I will reply soon.', err:'The message could not be sent. Please try again in a moment.' },
  pt: { name:'Nome completo', email:'E-mail', subject:'Assunto', message:'Mensagem', consent:'Li e concordo com a', policy:'política de privacidade', send:'Enviar mensagem', sending:'Enviando…', ok:'Obrigada! Sua mensagem foi enviada. Responderei em breve.', err:'Não foi possível enviar. Tente novamente em instantes.' },
}[lang];
const ld = { '@context':'https://schema.org','@type':'ContactPage',name:`${tr.contact} · ${site.name}`,url:(Astro.site?.origin ?? '') + `/${lang}/contacto/` };
---
<Base lang={lang} title={tr.contact} desc={`${tr.contact} · ${site.name} · ${site.city}`} path="contacto/" ld={ld}>
  <div class="wrap" style="max-width:680px">
    <h1 class="pt">{tr.contact}</h1>
    <form id="cf" class="cf" action="https://formspree.io/f/mleqqpab" method="POST" data-ok={F.ok} data-err={F.err} data-sending={F.sending}>
      <label>{F.name}<input name="name" required type="text" autocomplete="name" /></label>
      <label>{F.email}<input name="email" required type="email" autocomplete="email" /></label>
      <label>{F.subject}<input name="subject" required type="text" /></label>
      <label>{F.message}<textarea name="Message" required></textarea></label>
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />
      <label class="chk"><input id="RPGD" name="RPGD" type="checkbox" required value="Acepté la política de datos" /><span>{F.consent} <a href="https://www.misssam.com.ar/p/politicas-de-privacidad.html" target="_blank" rel="noopener">{F.policy}</a></span></label>
      <button class="btn" type="submit"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4zm0 0L11 13"/></svg>{F.send}</button>
      <p class="fm" role="status" aria-live="polite"></p>
    </form>
    <div style="margin-top:2rem"><Social items={site.social} /></div>
  </div>
  <script is:inline>
  (function(){var f=document.getElementById('cf');if(!f||!window.fetch)return;var m=f.querySelector('.fm');
  f.addEventListener('submit',function(e){e.preventDefault();var b=f.querySelector('button');b.disabled=true;m.className='fm';m.textContent=f.dataset.sending;
  fetch(f.action,{method:'POST',body:new FormData(f),headers:{Accept:'application/json'}}).then(function(r){if(!r.ok)throw 0;f.reset();m.className='fm ok';m.textContent=f.dataset.ok}).catch(function(){m.className='fm err';m.textContent=f.dataset.err}).then(function(){b.disabled=false})})})();
  </script>
</Base>
